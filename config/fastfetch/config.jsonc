{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "CachyOS_small",
    "color": {"1": "cyan", "2": "cyan"},
    "padding": {
      "top": 1,
      "left": 3,
      "right": 1
    }
  },
  "display": {
    "separator": " : "
  },
  "modules": [
    {
      "type": "command",
      "key": "  󰃰",
      "keyColor": "cyan",
      "text": "date '+%A, %d %B %Y'"
    },
    "break",
    {
      "type": "os",
      "key": "  ┌─ OS",
      "format": "{2}",
      "keyColor": "red"
    },
    {
      "type": "kernel",
      "key": "  ├─ Kernel",
      "format": "{2}",
      "keyColor": "red"
    },
    {
      "type": "disk",
      "key": "  ├─󱦟 OS Age",
      "folders": "/",
      "keyColor": "red",
      "format": "{days} days"
    },
    {
      "type": "uptime",
      "key": "  └─󱫐 Uptime",
      "keyColor": "red"
    },
    "break",
    {
      "type": "WM",
      "key": "  ┌─ WM",
      "keyColor": "green"
    },
    {
      "type": "terminal",
      "key": "  ├─ Terminal",
      "keyColor": "green"
    },
    {
      "type": "custom",
      "format": "Tokyo Night",
      "key": "  ├─󰉏 Theme",
      "keyColor": "green"
    },
    {
      "type": "packages",
      "key": "  └─󰏗 Packages",
      "keyColor": "green"
    },
    "break",
    {
      "type": "cpu",
      "format": "{1} {8}",
      "key": "  ┌─󰍛 CPU",
      "keyColor": "cyan"
    },
    {
      "type": "gpu",
      "format": "{1} {2}",
      "key": "  ├─󰊴 GPU",
      "keyColor": "cyan"
    },
    {
      "type": "memory",
      "key": "  ├─󰍛 RAM",
      "keyColor": "cyan"
    },
    {
      "type": "disk",
      "key": "  └─ Disk",
      "folders": "/",
      "format": "{1}/{2} ({3})",
      "keyColor": "cyan"
    },
    "break",
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    },
    "break"
  ]
}
